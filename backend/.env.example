# YourDay 后端环境变量样例。复制为 `.env` 后按需填写。

NODE_ENV=development
PORT=3001

# JWT 密钥。生产环境必须 ≥ 32 位，否则进程会拒绝启动。
# 生成方法： node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
TOKEN_TTL=7d
RESET_TOKEN_TTL=15m

# 跨域白名单（逗号分隔）。生产请填你备案的 Web 域名；小程序后端这里可不填。
# ALLOWED_ORIGINS=https://yourday.app,https://www.yourday.app
ALLOWED_ORIGINS=

# SQLite 数据目录（容器部署时建议挂载到云盘）
DB_PATH=
UPLOADS_DIR=

# 微信小程序 AppID / AppSecret（不写时 wxlogin 路由直接返 503）
WX_APPID=
WX_SECRET=

# 日志：production 默认写文件到 LOG_DIR/app.log
LOG_DIR=logs
LOG_LEVEL=info

# 管理后台初始账号。本地开发默认 admin / 123456；
# 生产环境不会创建默认弱密码，需显式配置 ADMIN_INITIAL_PASSWORD。
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
